{
  "name": "gestion.ctmueble.com.ar",
  "version": "1.2.0",
  "description": "El CTM es un centro de gestión, promoción y desarrollo de actividades para la Investigación, el Diseño y la Innovación, exclusivas de la industria del mueble. Su objeto principal es mejorar sustancialmente la competitividad de las fábricas de muebles y su cadena de valor aumentando su potencial para colocar sus productos en los mercados nacionales e internacionales.",
  "main": "src/app.js",
  "scripts": {
    "start": "node -r dotenv/config src/app.js",
    "start:express": "node -r dotenv/config src/app.js",
    "test": "node --test",
    "build:templates": "node scripts/sync-templates.js",
    "build:docs-pdf": "node scripts/build-docs-pdf.js",
    "postinstall": "node scripts/sync-templates.js",
    "migrate": "node -r dotenv/config src/infrastructure/migrations/run-migrations.js",
    "migrate:up": "node -r dotenv/config src/infrastructure/migrations/run-migrations.js up",
    "migrate:down": "node -r dotenv/config src/infrastructure/migrations/run-migrations.js down",
    "migrate:undo": "node -r dotenv/config src/infrastructure/migrations/run-migrations.js undo",
    "migrate:status": "node -r dotenv/config src/infrastructure/migrations/run-migrations.js status",
    "seed": "node -r dotenv/config src/infrastructure/seeders/run-default-types-seed.js",
    "seed:countries": "node -r dotenv/config src/infrastructure/seeders/run-default-types-seed.js --countries",
    "seed:provinces": "node -r dotenv/config src/infrastructure/seeders/run-default-types-seed.js --provinces",
    "seed:essay-types": "node -r dotenv/config src/infrastructure/seeders/run-default-types-seed.js --essay-types",
    "seed:lab": "node -r dotenv/config src/infrastructure/seeders/run-default-types-seed.js --lab",
    "seed:users": "node -r dotenv/config src/infrastructure/seeders/run-default-types-seed.js --users",
    "seed:reset-passwords": "node -r dotenv/config src/infrastructure/seeders/run-default-types-seed.js --users --reset-passwords",
    "create-user": "node -r dotenv/config src/infrastructure/seeders/run-create-user.js",
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.997.0",
    "@aws-sdk/s3-request-presigner": "^3.997.0",
    "@sparticuz/chromium": "^143.0.4",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.12.0",
    "handlebars": "^4.7.9",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "node-forge": "^1.3.2",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "puppeteer-core": "^24.35.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "serverless-http": "^4.0.0",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.5.1",
    "uuid": "^14.0.3",
    "written-number": "^0.11.1"
  },
  "devDependencies": {
    "puppeteer": "^24.35.0"
  }
}
